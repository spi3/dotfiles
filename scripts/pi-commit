#!/usr/bin/env sh

set -u

usage() {
    cat <<'EOF'
Usage: pi-commit [--dry-run | --apply]

Generate a Conventional Commits message from the staged Git diff.

  -n, --dry-run  Print and cache the message without committing (default)
  -a, --apply    Commit the staged changes with the generated message
  -h, --help     Show this help
EOF
}

MODE=dry-run
while [ "$#" -gt 0 ]; do
    case "$1" in
        -n|--dry-run)
            MODE=dry-run
            ;;
        -a|--apply)
            MODE=apply
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "pi-commit: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]; then
    echo "pi-commit: not inside a Git work tree" >&2
    exit 1
fi

TMP_WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/pi-commit.XXXXXX") || exit 1
trap 'rm -rf "$TMP_WORK_DIR"' 0
trap 'exit 1' 1 2 3 15

DIFF_FILE=$TMP_WORK_DIR/staged.diff
CURRENT_DIFF_FILE=$TMP_WORK_DIR/current-staged.diff
RAW_MESSAGE_FILE=$TMP_WORK_DIR/raw-message
MESSAGE_FILE=$TMP_WORK_DIR/message

if ! git --no-pager diff --cached --no-ext-diff --no-textconv --full-index --no-color -- > "$DIFF_FILE"; then
    echo "pi-commit: could not read the staged diff" >&2
    exit 1
fi

if [ ! -s "$DIFF_FILE" ]; then
    echo "pi-commit: there are no staged changes" >&2
    exit 1
fi

if ! DIFF_HASH=$(git hash-object "$DIFF_FILE"); then
    echo "pi-commit: could not hash the staged diff" >&2
    exit 1
fi

CACHE_DIR=$(git rev-parse --git-path pi-commit-cache) || exit 1
CACHE_FILE=$CACHE_DIR/v1-$DIFF_HASH
mkdir -p "$CACHE_DIR" || exit 1

is_valid_message() {
    [ -s "$1" ] || return 1
    FIRST_LINE=$(LC_ALL=C sed -n '1p' "$1") || return 1
    printf '%s\n' "$FIRST_LINE" | LC_ALL=C grep -Eq '^[a-z][a-z0-9-]*(\([^()]+\))?!?: .+$'
}

if is_valid_message "$CACHE_FILE"; then
    cp "$CACHE_FILE" "$MESSAGE_FILE" || exit 1
    echo "pi-commit: using the cached message for this staged diff" >&2
else
    if ! command -v pi >/dev/null 2>&1; then
        echo "pi-commit: pi is not installed or not on PATH" >&2
        exit 1
    fi

    SYSTEM_PROMPT='You are a commit-message writer. Return only the requested commit message as plain text, without Markdown fences or commentary.'
    PROMPT='Inspect the staged Git diff provided on standard input and write one Conventional Commits message that accurately summarizes the complete change.

Use the form "type(optional-scope): imperative description" with a lowercase type. Keep the subject concise (ideally at most 72 characters). Add a short body only when it provides important context. Return only the commit message.'

    echo "pi-commit: generating a message with pi" >&2
    if ! pi \
        --print \
        --no-session \
        --no-tools \
        --no-extensions \
        --no-skills \
        --no-prompt-templates \
        --no-themes \
        --no-context-files \
        --no-approve \
        --system-prompt "$SYSTEM_PROMPT" \
        -- "$PROMPT" < "$DIFF_FILE" > "$RAW_MESSAGE_FILE"; then
        echo "pi-commit: pi failed to generate a commit message" >&2
        exit 1
    fi

    if ! git stripspace < "$RAW_MESSAGE_FILE" > "$MESSAGE_FILE"; then
        echo "pi-commit: could not normalize pi's response" >&2
        exit 1
    fi

    if ! is_valid_message "$MESSAGE_FILE"; then
        echo "pi-commit: pi did not return a valid Conventional Commits message" >&2
        echo "Response:" >&2
        sed 's/^/  /' "$MESSAGE_FILE" >&2
        exit 1
    fi

    if ! git --no-pager diff --cached --no-ext-diff --no-textconv --full-index --no-color -- > "$CURRENT_DIFF_FILE"; then
        echo "pi-commit: could not re-read the staged diff" >&2
        exit 1
    fi
    if ! CURRENT_DIFF_HASH=$(git hash-object "$CURRENT_DIFF_FILE"); then
        echo "pi-commit: could not re-hash the staged diff" >&2
        exit 1
    fi
    if [ "$CURRENT_DIFF_HASH" != "$DIFF_HASH" ]; then
        echo "pi-commit: staged changes changed while pi was running; run again" >&2
        exit 1
    fi

    CACHE_TMP=$(mktemp "$CACHE_DIR/.message.XXXXXX") || exit 1
    if ! cp "$MESSAGE_FILE" "$CACHE_TMP" || ! mv "$CACHE_TMP" "$CACHE_FILE"; then
        rm -f "$CACHE_TMP"
        echo "pi-commit: could not cache the generated message" >&2
        exit 1
    fi
fi

if [ "$MODE" = "apply" ]; then
    echo "pi-commit: committing with message:" >&2
    sed 's/^/  /' "$MESSAGE_FILE" >&2
    git commit -F "$MESSAGE_FILE"
else
    cat "$MESSAGE_FILE"
fi
